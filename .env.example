# Anthropic API key (console.anthropic.com → API Keys). Never commit the real value.
ANTHROPIC_API_KEY=
# Upstash Redis (Vercel Marketplace → Upstash). Optional locally: falls back to .data/ file store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: require this code to run live generation on the public deployment.
GENERATE_ACCESS_CODE=
