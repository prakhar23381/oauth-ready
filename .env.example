# All free tiers; no credit card needed for the first two.
# Groq (primary LLM): https://console.groq.com/keys
GROQ_API_KEY=
# Tavily (web search, 1,000 free credits/month): https://app.tavily.com
TAVILY_API_KEY=
# Optional LLM fallbacks (used on rate limits):
# Mistral free "Experiment" plan (phone verification): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Google AI Studio free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Upstash Redis (Vercel Marketplace). Optional locally: falls back to .data/ file store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: require this code to run live generation on the public deployment.
GENERATE_ACCESS_CODE=
